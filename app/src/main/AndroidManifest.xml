<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The only permission: previews of saved links are fetched from the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- allowBackup is off on purpose (decision D-013): backup will be designed together with sync. -->
    <application
        android:name=".BandejaApp"
        android:allowBackup="false"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bandeja">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Bandeja.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Receives "Compartir". Exported because other apps must be able to start it, but it only reads
          EXTRA_TEXT/SUBJECT/TITLE as plain text; nothing from the Intent is ever executed or forwarded.
          No own task on purpose: it opens inside the task of the app the user came from, so finish() returns there.
        -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:theme="@style/Theme.Bandeja.Share"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/share_target_label">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
